layout {
    pane split_direction="vertical" {
        pane {
            command "hx"
            args "."
            focus true
            size "60%"
            name "Editor"
        }
        pane stacked=true {
            pane {
                name "Terminal"
            }
            pane {
                name "LazyGit"
                command "lazygit"
            }
            pane {
                name "AI"
                command "zsh"
                args "-ic" "ai; exec zsh"
            }
        }
    }
    pane size=1 borderless=true {
        plugin location="zellij:compact-bar"
    }

    swap_tiled_layout name="split-stacks" {
        tab {
            pane split_direction="vertical" {
                pane stacked=true size="60%" {
                    pane {
                        command "hx"
                        args "."
                        focus true
                        name "Editor"
                    }
                    pane {
                        name "LazyGit"
                        command "lazygit"
                    }
                }
                pane stacked=true {
                    pane {
                        name "AI"
                        command "zsh"
                        args "-ic" "ai; exec zsh"
                    }
                    pane {
                        name "Terminal"
                    }
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:compact-bar"
            }
        }
    }

    swap_tiled_layout name="stacked" {
        tab {
            pane stacked=true {
                pane {
                    command "hx"
                    args "."
                    focus true
                    name "Editor"
                }
                pane {
                    name "Terminal"
                }
                pane {
                    name "LazyGit"
                    command "lazygit"
                }
                pane {
                    name "AI"
                    command "zsh"
                    args "-ic" "ai; exec zsh"
                }
            }
            pane size=1 borderless=true {
                plugin location="zellij:compact-bar"
            }
        }
    }
}
